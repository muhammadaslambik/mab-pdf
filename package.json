{
  "name": "mab-pdf",
  "version": "0.1.0",
  "private": true,
  "description": "MAB-PDF: utilitas PDF gratis, diproses 100% di perangkat pengguna (client-side), bisa di-instal sebagai PWA.",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muhammadaslambik/mab-pdf.git"
